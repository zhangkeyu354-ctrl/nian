  "confirmedRules": [
    {
      "id": "R01",
      "sources": ["S04"],
      "text": "胜负用杀手定义仅为杀手、职业杀手、连环杀手。共犯和主谋不计入杀手人数。"
    },
    {
      "id": "R02",
      "sources": ["S04"],
      "text": "存活杀手人数大于等于存活无罪阵营人数时，有罪阵营获胜；全部杀手死亡时，无罪阵营获胜。零人同时死亡的通用优先级未显示，人质全灭例外见R07。"
    },
    {
      "id": "R03",
      "sources": ["S04", "S05"],
      "text": "准备时洗证据牌并取9张公共证据池；死者先选真遗言，私家侦探后主谋确认真遗言，再由杀手选2张假遗言。不得误称候选9张本身在原版就是保密信息。"
    },
    {
      "id": "R04",
      "sources": ["S05", "S07", "S10"],
      "text": "第一回合先处理灵魂伴侣，名犬保护在杀手选目标之前；名犬收回手的线下动作不等于线上公开身份。"
    },
    {
      "id": "R05",
      "sources": ["S10"],
      "text": "没有贵族影响时，多人夜间被杀共同只选一张真遗言，不能机械地为每名死者建立独立1真2假。"
    },
    {
      "id": "R06",
      "sources": ["S09"],
      "text": "职业杀手存活即增加假遗言，不限实际行凶者为职业杀手。"
    },
    {
      "id": "R07",
      "sources": ["S07"],
      "text": "人质全灭例外：如果所有玩家死亡，视为有罪阵营胜利。"
    },
    {
      "id": "R08",
      "sources": ["S07"],
      "text": "人质在行凶阶段死亡时，左右两侧同时死亡的玩家与其共同选择一张真遗言。"
    }
  ],
